<?xml version="1.0"?>
<package format="3">
  <name>esc</name>
  <version>1.0.0</version>
  <description>Integrated ESC package: motor teleop plus single-owner Ackermann command mux and STM32 serial bridge.</description>
  <maintainer email="maintainer@example.com">ESC Maintainer</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Static runtime-contract regression reads the installed YAML configuration. -->
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
