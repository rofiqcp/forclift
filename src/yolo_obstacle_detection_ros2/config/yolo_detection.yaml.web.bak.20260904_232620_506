# YOLOv8 object-detection-only runtime parameters.
# Docking / center-target visualization is intentionally NOT part of this node.
/**:
  ros__parameters:
    model_path: "/home/otomasi2/ros/models/yolov8n_agv_forklift.onnx"
    engine_path: ""
    confidence_threshold: 0.25
    iou_threshold: 0.45
    inference_size: 640
    max_inference_fps: 30
    max_visualization_fps: 22
    use_tensorrt: true
    use_cuda: true
    require_cuda: true
    use_gpu_preprocess: true
    allow_passthrough_without_model: true
    input_topic: "/camera/color/image_raw"
    output_topic: "/obstacle_detection/obstacles"
    visualization_topic: "/obstacle_detection/visualization"
    danger_zone_distance: 2.0
    warning_distance: 1.5
