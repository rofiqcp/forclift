<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#07100f">
  <link rel="icon" href="data:,">
  <title>AGV Forklift Operator Console</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <div class="brand-mark"><img src="/undip_logo.png" alt="UNDIP"></div>
        <div><strong>AGV Forklift</strong><span>ROS2 Humble • UNDIP</span></div>
      </div>
      <nav class="nav-list" aria-label="Navigasi dashboard">
        <div class="nav-section-label">OPERASI</div>
        <button class="nav-item active" data-page="overview"><span>◫</span><b>Overview</b></button>
        <button class="nav-item thesis-nav" data-page="experiments"><span>▦</span><b>BAB IV • Tuning</b><em>100 tests</em></button>
        <button class="nav-item" data-page="navigation"><span>⌖</span><b>Navigation Map</b></button>
        <button class="nav-item" data-page="perception"><span>◉</span><b>Perception Live</b></button>
        <button class="nav-item" data-page="esc"><span>⚙</span><b>ESC & Steering</b></button>
        <div class="nav-section-label">COMMISSIONING</div>
        <button class="nav-item" data-page="sensors"><span>≋</span><b>LiDAR & IMU</b></button>
        <button class="nav-item" data-page="calibration"><span>◎</span><b>Calibration</b></button>
        <button class="nav-item" data-page="tuning"><span>≡</span><b>Live Control</b></button>
        <div class="nav-section-label">BUKTI & SISTEM</div>
        <button class="nav-item" data-page="reports"><span>⇩</span><b>Reports & Export</b></button>
        <button class="nav-item" data-page="diagnostics"><span>⌁</span><b>Diagnostics</b></button>
        <button class="nav-item" data-page="configuration"><span>☷</span><b>Configuration</b></button>
      </nav>
      <div class="sidebar-bottom">
        <div class="mini-health"><i id="sseDot"></i><div><b id="sseLabel">Connecting</b><span id="serverClock">--:--:--</span></div></div>
        <div class="version">Web HMI v2.0 • ROS2 C++17 • :5005</div>
      </div>
    </aside>
    <button class="sidebar-backdrop" id="sidebarBackdrop" aria-label="Tutup menu"></button>

    <div class="main-shell">
      <header class="topbar">
        <button class="icon-button mobile-only" id="menuButton" aria-label="Buka menu">☰</button>
        <div class="page-heading"><span id="pageEyebrow">SYSTEM MONITOR</span><h1 id="pageTitle">Overview</h1></div>
        <div class="top-status">
          <div class="runtime-pill"><i id="rosDot"></i><span>ROS2</span><strong id="rosStatus">--</strong></div>
          <div class="runtime-pill"><i id="motionDot"></i><span>Motion</span><strong id="motionStatus">--</strong></div>
          <div class="runtime-pill danger" id="estopPill"><i></i><span>E-STOP</span><strong id="estopStatus">CLEAR</strong></div>
          <button class="icon-button" id="themeButton" title="Mode tampilan">◐</button>
        </div>
      </header>

      <main class="content">
        <!-- OVERVIEW -->
        <section class="page active" id="page-overview">
          <div class="hero-grid">
            <article class="panel hero-panel">
              <div class="panel-head"><div><span class="eyebrow">VEHICLE READINESS</span><h2>Operational Overview</h2></div><span class="status-chip waiting" id="overallChip">WAITING</span></div>
              <div class="readiness-ring-wrap">
                <div class="readiness-ring" id="readinessRing"><div><strong id="readinessPct">0%</strong><span>ready</span></div></div>
                <div class="readiness-copy"><h3 id="readinessTitle">Menunggu telemetry</h3><p id="readinessDetail">Dashboard akan menilai sensor, localization, Nav2, perception dan actuator secara realtime.</p><div class="micro-row"><span>Last update</span><b id="lastUpdate">--</b></div></div>
              </div>
            </article>
            <article class="panel mission-card">
              <div class="panel-head"><div><span class="eyebrow">MISSION</span><h2>Navigation State</h2></div><span class="live-dot"><i></i> LIVE</span></div>
              <div class="mission-state"><strong id="goalStateBig">IDLE</strong><span id="activeSourceBig">ACTUATOR: --</span></div>
              <div class="metric-3"><div><span>Speed</span><b id="overviewSpeed">--</b><small>m/s</small></div><div><span>Steering</span><b id="overviewSteer">--</b><small>deg</small></div><div><span>Yaw</span><b id="overviewYaw">--</b><small>deg</small></div></div>
            </article>
          </div>

          <div class="section-title"><div><span class="eyebrow">HARDWARE</span><h2>Sensor & Actuator Health</h2></div><span class="muted">Data aktual, bukan status sintetis</span></div>
          <div class="health-grid">
            <article class="health-card" data-health="lidar"><div class="health-icon">L</div><div><span>LIDAR</span><b id="healthLidar">OFFLINE</b><small id="healthLidarDetail">menunggu /scan_nav</small></div><i class="health-led"></i></article>
            <article class="health-card" data-health="imu"><div class="health-icon">I</div><div><span>IMU</span><b id="healthImu">OFFLINE</b><small id="healthImuDetail">menunggu /imu/connected</small></div><i class="health-led"></i></article>
            <article class="health-card" data-health="camera"><div class="health-icon">C</div><div><span>CAMERA</span><b id="healthCamera">OFFLINE</b><small id="healthCameraDetail">Astra Pro</small></div><i class="health-led"></i></article>
            <article class="health-card" data-health="esc"><div class="health-icon">E</div><div><span>ESC</span><b id="healthEsc">OFFLINE</b><small id="healthEscDetail">serial / ACK</small></div><i class="health-led"></i></article>
            <article class="health-card" data-health="localization"><div class="health-icon">L</div><div><span>LOCALIZATION</span><b id="healthLocalization">WAIT</b><small id="healthLocalizationDetail">map → odom → base</small></div><i class="health-led"></i></article>
            <article class="health-card" data-health="nav2"><div class="health-icon">N</div><div><span>NAV2</span><b id="healthNav2">WAIT</b><small id="healthNav2Detail">planner / controller</small></div><i class="health-led"></i></article>
          </div>

          <div class="two-col">
            <article class="panel">
              <div class="panel-head"><div><span class="eyebrow">COMMAND CHAIN</span><h2>Velocity Pipeline</h2></div></div>
              <div class="pipeline">
                <div><span>Nav2</span><b id="pipeNav">0.00</b></div><em>→</em><div><span>Safety</span><b id="pipeSafety">0.00</b></div><em>→</em><div><span>Final</span><b id="pipeFinal">0.00</b></div><em>→</em><div><span>Actuator</span><b id="pipeActuator">0.00</b></div>
              </div>
              <canvas class="spark" id="speedSpark" width="900" height="180"></canvas>
            </article>
            <article class="panel alert-panel">
              <div class="panel-head"><div><span class="eyebrow">ATTENTION</span><h2>Active Conditions</h2></div><span class="count-badge" id="alertCount">0</span></div>
              <div id="alerts" class="alert-list"><div class="empty-state">Belum ada data status.</div></div>
            </article>
          </div>
        </section>

        <!-- NAVIGATION -->
        <section class="page" id="page-navigation">
          <div class="map-layout">
            <article class="panel map-panel">
              <div class="panel-head map-head"><div><span class="eyebrow">LIVE MAP</span><h2>Navigation Workspace</h2></div><div class="toolbar nav-map-toolbar"><label class="nav-map-picker"><span>Display map</span><select id="navMapSelect"><option value="live">LIVE / ACTIVE MAP</option><option value="saved-1">MAP 1 • hasil build</option><option value="saved-2">MAP 2 • hasil build</option><option value="saved-3">MAP 3 • hasil build</option></select></label><span class="status-chip" id="navMapSourceChip">LIVE</span><button class="soft-btn" id="mapCenterBtn">Center Robot</button><button class="soft-btn" id="mapFitBtn">Fit Map</button></div></div>
              <div class="map-stage" id="mapStage"><canvas id="mapCanvas" width="1200" height="720"></canvas><div class="map-source-badge" id="navMapSourceBadge">LIVE / ACTIVE MAP</div><div class="map-legend"><span><i class="occupancy-key"></i> Occupancy grid</span><span><i class="inflation-key"></i> Global inflation</span><span><i class="costmap-key"></i> Local costmap</span><span><i class="robot-key"></i> Robot</span><span><i class="path-key"></i> Global path</span><span><i class="local-key"></i> Local path</span><span><i class="goal-key"></i> Goal</span></div><div class="map-placeholder" id="mapPlaceholder">Menunggu /map...</div></div>
            </article>
            <div class="stack">
              <article class="panel control-card">
                <div class="panel-head"><div><span class="eyebrow">GOAL CONTROL</span><h2>Set Navigation Goal</h2></div></div>
                <label>X map (m)<input type="number" step="0.01" id="goalX" value="0"></label>
                <label>Y map (m)<input type="number" step="0.01" id="goalY" value="0"></label>
                <label>Yaw (deg)<input type="number" step="1" id="goalYaw" value="0"></label>
                <div class="button-row"><button class="primary-btn" id="sendGoalBtn">Send Goal</button><button class="danger-btn" id="cancelGoalBtn">Cancel</button></div>
                <p class="hint" id="goalMapHint">Klik peta LIVE / ACTIVE MAP untuk mengisi X/Y. Goal tetap melewati NavigationCore dan safety gate kendaraan.</p>
              </article>
              <article class="panel compact nav-switch-card">
                <div class="panel-head"><div><span class="eyebrow">MAP NAV2 CONTROL</span><h2>Activate Selected Build</h2></div><span class="status-chip waiting" id="navSwitchChip">NAV2 OFF</span></div>
                <div class="kv-list"><div><span>Selected view</span><b id="navSelectedMap">LIVE</b></div><div><span>Active Nav2 map</span><b id="navActiveMap">--</b></div><div><span>State</span><b id="navSwitchState">--</b></div></div>
                <div class="button-row nav-switch-actions"><button class="primary-btn grow" id="startNavMapBtn">START NAV2</button><button class="danger-btn grow" id="stopNavMapBtn">STOP NAV2</button></div>
                <p class="hint" id="navSwitchMessage">Pilih MAP 1/2/3 hasil build untuk mengaktifkannya pada Nav2.</p>
              </article>
              <article class="panel compact"><div class="panel-head"><div><span class="eyebrow">POSE</span><h2>Current Estimate</h2></div></div><div class="kv-list"><div><span>X</span><b id="poseX">--</b></div><div><span>Y</span><b id="poseY">--</b></div><div><span>Yaw</span><b id="poseYaw">--</b></div><div><span>Velocity</span><b id="poseV">--</b></div><div><span>Path length</span><b id="pathLength">--</b></div></div></article>
              <article class="panel compact"><div class="panel-head"><div><span class="eyebrow">INITIAL POSE</span><h2>Localization Tool</h2></div></div><div class="button-row"><button class="soft-btn grow" id="usePoseForInitial">Use Current</button><button class="soft-btn grow" id="resetLocalizationBtn">Reset Samples</button></div></article>
            </div>
          </div>
          <div class="four-metrics"><div><span>Goal state</span><b id="navGoalState">--</b></div><div><span>Nav2 ready</span><b id="navReady">--</b></div><div><span>MPPI loop</span><b id="mppiReady">--</b></div><div><span>Collision monitor</span><b id="collisionState">--</b></div></div>
        </section>

        <!-- PERCEPTION -->
        <section class="page" id="page-perception">
          <article class="panel alignment-summary-panel">
            <div class="panel-head alignment-head"><div><span class="eyebrow">PALLET ALIGNMENT</span><h2>Hole-Guided Middle Block</h2></div><span class="status-chip waiting" id="alignStatusChip">WAIT</span></div>
            <div class="alignment-groups">
              <div class="alignment-group"><h3>Detection</h3><div class="alignment-kv">
                <div><span>Left hole</span><b id="alignLeftHole">--</b></div>
                <div><span>Right hole</span><b id="alignRightHole">--</b></div>
                <div><span>Hole pair</span><b id="alignHolePair">--</b></div>
                <div><span>Hole gate</span><b id="alignHoleGate">--</b></div>
                <div><span>Middle block</span><b id="alignMiddleBlock">--</b></div>
                <div><span>Candidates</span><b id="alignCandidates">--</b></div>
                <div><span>Block geom</span><b id="alignBlockGeom">--</b></div>
                <div><span>Stable frame</span><b id="alignStable">--</b></div>
              </div></div>
              <div class="alignment-group"><h3>Geometry</h3><div class="alignment-kv">
                <div><span>Midpoint</span><b id="alignMidpoint">--</b></div>
                <div><span>Hole separation</span><b id="alignSeparation">--</b></div>
                <div><span>Centerline n</span><b id="alignCenterline">--</b></div>
                <div><span>Block offset</span><b id="alignBlockOffset">--</b></div>
                <div><span>Expected block</span><b id="alignExpected">--</b></div>
                <div><span>Detected block</span><b id="alignDetected">--</b></div>
                <div><span>Residual</span><b id="alignResidual">--</b></div>
              </div></div>
              <div class="alignment-group"><h3>Reference</h3><div class="alignment-kv">
                <div><span>Target center</span><b id="alignTargetCenter">--</b></div>
                <div><span>Target box</span><b id="alignTargetBox">--</b></div>
                <div><span>Yaw offset</span><b id="alignYawOffset">--</b></div>
                <div><span>Meter / pixel</span><b id="alignMpp">--</b></div>
                <div><span>Metric valid</span><b id="alignMetric">--</b></div>
              </div></div>
              <div class="alignment-group alignment-output"><h3>Alignment Output</h3><div class="alignment-kv">
                <div><span>Lateral error</span><b id="alignLatM">--</b></div>
                <div><span>Lateral debug</span><b id="alignLatPx">--</b></div>
                <div><span>Yaw error</span><b id="alignYaw">--</b></div>
                <div><span>Aligned</span><b id="alignAligned">--</b></div>
                <div class="alignment-status-row"><span>Status</span><b id="alignStatusText">--</b></div>
              </div></div>
              <div class="alignment-group"><h3>Lane Safety</h3><div class="alignment-kv">
                <div><span>State</span><b id="laneState">--</b></div>
                <div><span>Control</span><b id="laneControl">--</b></div>
                <div><span>Drivable</span><b id="drivableState">--</b></div>
                <div><span>Near field</span><b id="nearFieldState">--</b></div>
              </div></div>
              <div class="alignment-group"><h3>Planning Inputs</h3><div class="alignment-kv">
                <div><span>Objects</span><b id="cloudObjects">--</b></div>
                <div><span>Path relevant</span><b id="cloudPath">--</b></div>
                <div><span>Planning</span><b id="cloudPlanning">--</b></div>
                <div><span>Boundary</span><b id="cloudBoundary">--</b></div>
              </div></div>
            </div>
          </article>
          <div class="camera-layout">
            <article class="panel camera-panel"><div class="panel-head"><div><span class="eyebrow">ASTRA PRO / YOLOv8 + HOLE-BLOCK ALIGNMENT</span><h2>Live Perception</h2></div><span class="status-chip waiting" id="cameraChip">WAIT</span></div><div class="camera-stage"><img id="cameraImage" alt="Live camera frame"><canvas id="alignmentOverlayCanvas"></canvas><div id="cameraPlaceholder" class="camera-placeholder">Menunggu frame kamera...</div><div class="camera-meta"><span id="cameraSource">--</span><span id="cameraResolution">--</span></div></div></article>
          </div>
          <div class="two-col">
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">PERFORMANCE</span><h2>Inference & Camera Health</h2></div></div><div class="json-pretty" id="perceptionPerformance">No performance telemetry yet.</div></article>
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">DETECTIONS</span><h2>Obstacle / Raw Detection</h2></div></div><div class="json-pretty" id="detectionsView">No detections yet.</div></article>
          </div>
        </section>

        <!-- SENSORS -->
        <section class="page" id="page-sensors">
          <div class="sensor-hero">
            <article class="panel">
              <div class="panel-head"><div><span class="eyebrow">YDLIDAR TMINI PLUS</span><h2>LiDAR 2D / Scan Navigation</h2></div><span class="status-chip waiting" id="lidarChip">WAIT</span></div>
              <div class="big-coordinates"><div><span>CENTER RANGE</span><b id="lidarCenter">--</b></div><div><span>VALID RATIO</span><b id="lidarValid">--</b></div></div>
              <div class="metric-grid"><div><span>Scan rate</span><b id="lidarRate">--</b></div><div><span>Samples</span><b id="lidarSamples">--</b></div><div><span>Dropout</span><b id="lidarDropout">--</b></div><div><span>Min range</span><b id="lidarMin">--</b></div><div><span>Max range</span><b id="lidarMax">--</b></div><div><span>Safety</span><b id="lidarSafety">--</b></div></div>
            </article>
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">YAHBOOM IMU</span><h2>Orientation & Motion</h2></div><span class="status-chip waiting" id="imuChip">WAIT</span></div><div class="orientation-display"><div class="compass"><div class="needle" id="imuNeedle"></div><span>N</span></div><div class="orientation-values"><div><span>Roll</span><b id="imuRoll">--</b></div><div><span>Pitch</span><b id="imuPitch">--</b></div><div><span>Yaw</span><b id="imuYaw">--</b></div></div></div><div class="metric-grid"><div><span>Gyro X</span><b id="imuGx">--</b></div><div><span>Gyro Y</span><b id="imuGy">--</b></div><div><span>Gyro Z</span><b id="imuGz">--</b></div><div><span>Accel X</span><b id="imuAx">--</b></div><div><span>Accel Y</span><b id="imuAy">--</b></div><div><span>Accel Z</span><b id="imuAz">--</b></div></div></article>
          </div>
          <div class="two-col"><article class="panel"><div class="panel-head"><div><span class="eyebrow">LIDAR DRIVER</span><h2>Scan & Safety Detail</h2></div></div><div id="lidarDetail" class="json-pretty">Waiting...</div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">LOCALIZATION</span><h2>AMCL / EKF State</h2></div></div><div id="localizationDetail" class="json-pretty">Waiting...</div></article></div>
        </section>

        <!-- ESC -->
        <section class="page" id="page-esc">
          <div class="esc-hero">
            <article class="panel esc-status-card"><div class="panel-head"><div><span class="eyebrow">SERIAL ACTUATOR</span><h2>ESC Runtime</h2></div><span class="status-chip waiting" id="escChip">OFFLINE</span></div><div class="esc-connection"><div class="connection-orb" id="escOrb"><span>ESC</span></div><div><h3 id="escConnectionTitle">No ACK</h3><p id="escConnectionDetail">Menunggu serial CH340 di physical USB path ESC.</p><div class="path-tag">AUTO PATH <b>usb-0:1.1:1.0</b></div></div></div><div class="metric-grid"><div><span>Drive target</span><b id="escDriveTarget">--</b></div><div><span>Drive actual</span><b id="escDriveActual">--</b></div><div><span>Steer target</span><b id="escSteerTarget">--</b></div><div><span>Steer actual</span><b id="escSteerActual">--</b></div><div><span>Yaw rate</span><b id="escYawRate">--</b></div><div><span>MUX source</span><b id="escMuxSource">--</b></div></div></article>
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">STEERING CALIBRATION</span><h2>Calibration Control</h2></div><span class="status-chip waiting" id="calibrationChip">SAFE</span></div><p class="info-box">Mode kalibrasi memaksa drive RPM = 0. Aktifkan hanya saat kendaraan aman dan roda steering dapat bergerak bebas.</p><div class="button-row"><button class="warning-btn grow" id="calModeOn">Enable Calibration</button><button class="soft-btn grow" id="calModeOff">Disable</button></div><div class="kv-list spaced"><div><span>Controller ready</span><b id="calControllerReady">--</b></div><div><span>Raw command</span><b id="escRawCommand">--</b></div><div><span>Raw feedback</span><b id="escRawFeedback">--</b></div><div><span>Physical feedback</span><b id="escPhysicalFeedback">--</b></div></div></article>
          </div>
          <div class="two-col"><article class="panel"><div class="panel-head"><div><span class="eyebrow">ESC DIAGNOSTIC</span><h2>Protocol State</h2></div></div><div class="json-pretty" id="escStatusRaw">Waiting...</div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">FOC TELEMETRY</span><h2>Electrical Data</h2></div></div><div class="json-pretty" id="focTelemetry">Topic /esc/foc/telemetry belum tersedia.</div></article></div>
          <article class="panel troubleshooting"><div class="panel-head"><div><span class="eyebrow">ESC TROUBLESHOOTING</span><h2>Why Motor Is Not Moving</h2></div></div><div class="checklist" id="escChecklist"></div></article>
        </section>

        <!-- CALIBRATION -->
        <section class="page" id="page-calibration">
          <div class="four-metrics"><div><span>Steering physical</span><b id="calSteeringFlag">WAIT</b></div><div><span>Circle geometry</span><b id="calCircleFlag">WAIT</b></div><div><span>Drive odometry</span><b id="calDriveFlag">WAIT</b></div><div><span>IMU stationary</span><b id="calImuFlag">WAIT</b></div></div>
          <div class="two-col">
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">LOCALIZATION CALIBRATION</span><h2>AMCL / Map Alignment</h2></div><span class="status-chip waiting" id="calLocChip">WAIT</span></div><p class="info-box">Initial pose dan validasi AMCL tetap fail-closed terhadap motion sampai map, LiDAR, TF, dan Nav2 siap.</p><div class="kv-list"><div><span>Localization mode</span><b id="calLocMode">--</b></div><div><span>Nav2 runtime</span><b id="calPlanningReady">--</b></div><div><span>Motion permission</span><b id="calMotionReady">--</b></div><div><span>AMCL pose</span><b id="calAmclFresh">--</b></div></div><div class="button-row"><button class="warning-btn grow" id="calResetLocalization">Reset Localization Samples</button></div></article>
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">STEERING</span><h2>Physical Calibration Gate</h2></div><span class="status-chip waiting" id="calSteerChip">WAIT</span></div><div class="kv-list"><div><span>Controller</span><b id="calSteerController">--</b></div><div><span>Target</span><b id="calSteerTarget">--</b></div><div><span>Actual</span><b id="calSteerActual">--</b></div><div><span>Protocol feedback</span><b id="calSteerProtocol">--</b></div></div><div class="button-row"><button class="warning-btn grow" id="calModeOn2">Enable Safe Cal Mode</button><button class="soft-btn grow" id="calModeOff2">Disable</button></div></article>
          </div>
          <div class="two-col">
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">CAMERA METRIC</span><h2>Astra / Perception Calibration</h2></div><span class="status-chip waiting" id="calCameraChip">WAIT</span></div><div class="kv-list"><div><span>USB camera</span><b id="calCameraUsb">--</b></div><div><span>Frame health</span><b id="calCameraHealth">--</b></div><div><span>Metric validated</span><b id="calCameraMetric">--</b></div><div><span>Inference freshness</span><b id="calPerceptionFresh">--</b></div></div><p class="hint">Titik/homography kamera tetap mengikuti source calibration GUI lama. Web menampilkan gate aktual dan tidak menandai PASS secara sintetis.</p></article>
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">IMU</span><h2>Orientation Calibration</h2></div><span class="status-chip waiting" id="calImuChip">WAIT</span></div><div class="kv-list"><div><span>Serial IMU</span><b id="calImuUsb">--</b></div><div><span>Stationary validated</span><b id="calImuStationary">--</b></div><div><span>Yaw</span><b id="calImuYaw">--</b></div><div><span>Gyro Z</span><b id="calImuGz">--</b></div></div></article>
          </div>
        </section>

        <!-- TUNING -->
        <section class="page" id="page-tuning">
          <div class="four-metrics"><div><span>MPPI closed loop</span><b id="tuneMppiReady">--</b></div><div><span>Smoother eligible</span><b id="tuneSmoother">--</b></div><div><span>Velocity error</span><b id="tuneVelErr">--</b></div><div><span>Steering error</span><b id="tuneSteerErr">--</b></div></div>
          <div class="two-col">
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">LIVE CONTROL LOOP</span><h2>Command vs Feedback</h2></div></div><div class="metric-grid"><div><span>Nav2 cmd</span><b id="tuneNavCmd">--</b></div><div><span>Final cmd</span><b id="tuneFinalCmd">--</b></div><div><span>Drive target</span><b id="tuneDriveTarget">--</b></div><div><span>Drive actual</span><b id="tuneDriveActual">--</b></div><div><span>Steer target</span><b id="tuneSteerTarget">--</b></div><div><span>Steer actual</span><b id="tuneSteerActual">--</b></div></div><canvas class="spark" id="tuneSpark" width="900" height="220"></canvas></article>
            <article class="panel"><div class="panel-head"><div><span class="eyebrow">QUALIFICATION</span><h2>MPPI / Velocity Smoother</h2></div></div><div class="json-pretty" id="tuneQualification">Waiting...</div></article>
          </div>
          <div class="two-col"><article class="panel"><div class="panel-head"><div><span class="eyebrow">NAV2 SOURCE</span><h2>Controller / Planner Configuration</h2></div></div><div class="json-pretty tall" id="tuneNavConfig">Load Configuration first.</div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">VEHICLE / ESC SOURCE</span><h2>Limits & Calibration Configuration</h2></div></div><div class="json-pretty tall" id="tuneVehicleConfig">Load Configuration first.</div></article></div>
        </section>

        <!-- BAB IV / TUNING WORKBENCH -->
        <section class="page" id="page-experiments">
          <div class="lab-hero panel">
            <div>
              <span class="eyebrow">THESIS ENGINEERING WORKBENCH</span>
              <h2>BAB IV • Pengujian, Tuning & Evidence</h2>
              <p>Urutan pengujian langsung dari source ROS. Parameter editable menulis YAML source-of-truth secara atomik; raw telemetry direkam server-side ke CSV.</p>
            </div>
            <div class="lab-stat-strip">
              <div><span>Domain</span><b>3</b><small>NAV • VISION • ESC</small></div>
              <div><span>Pengujian</span><b id="labLeafCount">100</b><small>source catalog</small></div>
              <div><span>Recorder</span><b id="labRecorderState">IDLE</b><small id="labRecorderSamples">0 samples</small></div>
              <div><span>YAML</span><b id="labYamlMode">WRITE</b><small>atomic + backup</small></div>
            </div>
          </div>

          <div class="domain-switch" role="tablist" aria-label="Domain pengujian BAB IV">
            <button class="domain-tab active" data-exp="navigation"><span class="domain-icon">N</span><div><b>Navigasi</b><small>Sensor → EKF → Localization → Costmap → Smac → MPPI → Goal</small></div><em id="navTestCount">50</em></button>
            <button class="domain-tab" data-exp="perception"><span class="domain-icon">P</span><div><b>Persepsi</b><small>Camera → Detection → Metric → Drivable → Lane → Safety → Performance</small></div><em id="perTestCount">35</em></button>
            <button class="domain-tab" data-exp="steering"><span class="domain-icon">E</span><div><b>ESC / FOC</b><small>Calibration → Current Loop → Position → Step → Tracking → Load → Final Gate</small></div><em id="escTestCount">15</em></button>
          </div>

          <div class="workbench-grid">
            <aside class="panel chapter-browser">
              <div class="chapter-tools">
                <div><span class="eyebrow">TEST SEQUENCE</span><h2 id="chapterDomainTitle">Navigasi</h2></div>
                <input id="experimentSearch" class="chapter-search" type="search" placeholder="Cari 4.1, EKF, MPPI..." autocomplete="off">
              </div>
              <div class="chapter-progress"><div><span id="chapterProgressText">0 / 50 dibuka</span><b id="chapterProgressPct">0%</b></div><i><em id="chapterProgressBar"></em></i></div>
              <div id="experimentList" class="experiment-list chapter-list"></div>
            </aside>

            <div class="workbench-main">
              <article class="panel experiment-detail lab-section-head">
                <div class="selected-title-row">
                  <div><span class="eyebrow" id="experimentGroup">SELECTED TEST</span><h2 id="experimentTitle">Pilih pengujian</h2><p id="experimentSubtitle">Katalog diambil langsung dari agv_experiment_catalog.hpp.</p></div>
                  <div class="test-badges"><span id="experimentTableBadge">0 TABLE</span><span id="experimentGraphBadge">0 GRAPH</span><span id="experimentSourceBadge">WAITING</span></div>
                </div>
                <div id="experimentDetail" class="sr-only">Metadata source catalog.</div>
              </article>

              <article class="panel run-console">
                <div class="panel-head"><div><span class="eyebrow">RUN CONTROL</span><h2>Identitas Run & CSV Evidence</h2></div><span class="status-chip waiting" id="recordChip">IDLE</span></div>
                <div class="run-grid">
                  <label>Variation / Run<input id="runVariation" value="run-01" autocomplete="off"></label>
                  <label>Condition<input id="runCondition" value="nominal" autocomplete="off"></label>
                  <label>Sample rate<input id="runSampleRate" type="number" min="1" max="20" step="1" value="5"><small id="runSampleRateUnit">Hz</small></label>
                  <div class="record-actions"><button class="record-start" id="startCsvBtn">● START CSV</button><button class="record-stop" id="stopCsvBtn" disabled>■ STOP + AUTO SAVE</button></div>
                </div>
                <div class="record-footer"><span id="recordElapsed">00:00.0</span><span id="recordPath">Output: ~/.ros/agv_web_reports</span><span id="recordMessage">Raw + summary + config snapshot + manifest</span></div>
              </article>

              <div class="lab-two-col">
                <article class="panel tuning-editor">
                  <div class="panel-head"><div><span class="eyebrow">PARAMETER TUNING</span><h2>YAML Aktual</h2></div><div class="button-row"><button class="soft-btn" id="refreshExperimentConfig">Reload YAML</button><button class="danger-btn" id="resetExperimentYaml" hidden>↶ RESET PARAMS</button></div></div>
                  <div class="tuning-note" id="tuningNote">Nilai editable disimpan ke source YAML. Perubahan node Nav2/EKF umumnya berlaku setelah lifecycle reload/restart.</div>
                  <div id="tuningFields" class="tuning-fields"><div class="empty-state">Pilih subpengujian.</div></div>
                </article>

                <article class="panel context-panel">
                  <div class="panel-head"><div><span class="eyebrow">CONTEXT VISUAL</span><h2 id="contextTitle">Live Evidence</h2></div><div class="context-tabs"><button class="active" data-context="auto">AUTO</button><button data-context="raw">RAW</button></div></div>
                  <div id="contextVisual" class="context-visual">
                    <div class="context-map" id="contextMap"><canvas id="expMapCanvas" width="900" height="520"></canvas><div class="context-empty" id="expMapEmpty">Map belum tersedia</div></div>
                    <div class="context-camera" id="contextCamera"><img id="expCameraImage" alt="Perception evidence"><canvas id="expAlignmentOverlayCanvas"></canvas><div class="context-scan-hud" id="expScanHud"><div class="scan-hud-head"><b id="expScanState">WAIT CAMERA</b><span id="expScanFresh">WAIT</span></div><div class="scan-hud-grid"><div><span>Jarak Depan LiDAR</span><b id="expScanDistance">--</b></div><div><span>Obstacle YOLO</span><b id="expScanObstacle">--</b></div><div><span>Hole Pair</span><b id="expScanHolePair">--</b></div><div><span>Middle Block</span><b id="expScanBlock">--</b></div><div><span>Error Lateral</span><b id="expScanLateral">--</b></div><div><span>Error Yaw</span><b id="expScanYaw">--</b></div><div class="scan-hud-wide"><span>Set Point</span><b id="expScanSetpoint">X[525,755] Y[560,720]</b></div></div></div><div class="context-empty" id="expCameraEmpty">Camera frame belum tersedia</div></div>
                    <div class="context-esc" id="contextEsc"><canvas id="expEscCanvas" width="900" height="520"></canvas></div>
                  </div>
                  <div class="context-metrics" id="contextMetrics"></div>
                </article>
              </div>

              <article class="panel graph-workspace">
                <div class="panel-head"><div><span class="eyebrow">LIVE / SUMMARY</span><h2>Grafik Pengujian</h2></div><div class="graph-controls"><button class="soft-btn active" id="graphLiveMode">LIVE</button><button class="soft-btn" id="graphClearBtn">Clear</button></div></div>
                <div id="graphTabs" class="lab-tabs"></div>
                <div id="experimentGraphs" class="experiment-graphs"><div class="empty-state">Subbab ini tidak mendefinisikan grafik.</div></div>
              </article>

              <article class="panel table-workspace">
                <div class="panel-head"><div><span class="eyebrow">REPORT TABLE</span><h2>Tabel Pengujian</h2></div><div class="button-row"><button class="soft-btn" id="saveTableCsvBtn">Simpan CSV</button><button class="primary-btn" id="saveTableExcelBtn">Simpan Excel</button></div></div><div class="record-footer"><span class="muted" id="tableLiveHint">Preview live + hasil run</span></div>
                <div id="tableTabs" class="lab-tabs"></div>
                <div class="table-scroll"><table class="data-table experiment-data-table" id="experimentTable"><thead></thead><tbody></tbody></table></div>
              </article>

              <article class="panel audit-ribbon">
                <div><span class="eyebrow">SOURCE & METHOD</span><b id="sourceMethod">Menunggu subbab.</b></div>
                <div id="sourceAvailability" class="source-pills"></div>
                <details><summary>Metadata katalog & raw source</summary><pre id="experimentRawMetadata" class="raw-json">{}</pre></details>
              </article>
            </div>
          </div>
        </section>

        <!-- REPORTS -->
        <section class="page" id="page-reports">
          <div class="hero-grid">
            <article class="panel hero-panel"><div class="panel-head"><div><span class="eyebrow">EXPORT CENTER</span><h2>Runtime Evidence & Reports</h2></div><span class="status-chip" id="reportLiveChip">LIVE</span></div><p>Ekspor dibuat langsung dari telemetry yang sedang diterima browser. Tidak ada data dummy dan tidak mengubah parameter kendaraan.</p><div class="report-actions"><button class="primary-btn" id="exportStateBtn">Telemetry JSON</button><button class="soft-btn" id="exportConfigBtn">Configuration JSON</button><button class="soft-btn" id="exportExperimentsBtn">BAB IV Catalog</button><button class="soft-btn" id="exportCsvBtn">Summary CSV</button><button class="soft-btn" id="printReportBtn">Print / PDF</button></div></article>
            <article class="panel mission-card"><div class="panel-head"><div><span class="eyebrow">SNAPSHOT</span><h2>Evidence Summary</h2></div></div><div class="metric-3"><div><span>Channels</span><b id="reportChannels">0</b></div><div><span>Fresh &lt;3s</span><b id="reportFresh">0</b></div><div><span>Warnings</span><b id="reportWarnings">0</b></div></div><p class="hint" id="reportTimestamp">No snapshot yet.</p></article>
          </div>
          <div class="two-col"><article class="panel"><div class="panel-head"><div><span class="eyebrow">RUN STATUS</span><h2>System Snapshot</h2></div></div><div class="json-pretty" id="reportSnapshot">Waiting...</div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">AUDIT NOTE</span><h2>Export Contents</h2></div></div><div class="checklist"><div class="check-item ok"><i>✓</i><div><b>Telemetry</b><span>Latest ROS2 state + timestamps</span></div></div><div class="check-item ok"><i>✓</i><div><b>Configuration</b><span>YAML snapshot exposed by C++ backend</span></div></div><div class="check-item ok"><i>✓</i><div><b>BAB IV</b><span>Same agv_experiment_catalog.hpp as Qt GUI</span></div></div><div class="check-item ok"><i>✓</i><div><b>Safety</b><span>Exports are read-only; no actuator command is sent</span></div></div></div></article></div>
        </section>

        <!-- DIAGNOSTICS -->
        <section class="page" id="page-diagnostics">
          <div class="four-metrics"><div><span>SSE connection</span><b id="diagSse">--</b></div><div><span>State channels</span><b id="diagChannels">0</b></div><div><span>Server latency</span><b id="diagLatency">--</b></div><div><span>Web mode</span><b id="diagReadOnly">--</b></div></div>
          <div class="two-col"><article class="panel"><div class="panel-head"><div><span class="eyebrow">SYSTEM STATUS</span><h2>ROS Runtime Snapshot</h2></div><button class="soft-btn" id="refreshStateBtn">Refresh</button></div><div class="diagnostic-table" id="diagnosticTable"></div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">EVENT</span><h2>Latest Web Action</h2></div></div><div class="json-pretty" id="webAction">No web action yet.</div><div class="panel-head sub"><div><span class="eyebrow">RAW STATE</span><h2>Developer Inspector</h2></div></div><details><summary>Show JSON</summary><pre class="raw-json" id="rawState">{}</pre></details></article></div>
        </section>

        <!-- CONFIGURATION -->
        <section class="page" id="page-configuration">
          <article class="panel"><div class="panel-head"><div><span class="eyebrow">READ-ONLY CONFIG VIEW</span><h2>Active Configuration</h2></div><button class="soft-btn" id="refreshConfigBtn">Reload</button></div><p class="info-box">Web UI menampilkan source-of-truth YAML yang sama dengan GUI C++. Editing parameter kritis tetap dilakukan melalui GUI/commissioning flow agar tidak bypass validasi.</p><div class="config-tabs" id="configTabs"></div><div class="config-view" id="configView">Loading...</div></article>
        </section>
      </main>

      <footer class="footer"><span>ADV Operator Console</span><span id="footerStatus">Connecting to ROS2 bridge…</span><span>localhost:5000</span></footer>
    </div>
  </div>
  <div class="toast-stack" id="toastStack" aria-live="polite"></div>
  <div class="modal-backdrop" id="confirmModal"><div class="modal"><span class="eyebrow">CONFIRM ACTION</span><h2 id="confirmTitle">Confirm</h2><p id="confirmText"></p><div class="button-row"><button class="soft-btn grow" id="confirmNo">Cancel</button><button class="danger-btn grow" id="confirmYes">Continue</button></div></div></div>
  <script src="/app.js" defer></script>
</body>
</html>
