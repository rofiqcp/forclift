function configValue(file,path){let n=configs[file]?.data;if(n==null)return undefined;for(const part of String(path||'').split('.').filter(Boolean)){if(Array.isArray(n)&&/^\d+$/.test(part))n=n[+part];else if(n&&typeof n==='object')n=n[part];else return undefined}return n}
