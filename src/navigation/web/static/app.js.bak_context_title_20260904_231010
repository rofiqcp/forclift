function drawAlignmentOverlay(a=latestAlignment){
  const c=$('alignmentOverlayCanvas'),img=$('cameraImage');
  if(!c)return;
  const rect=c.getBoundingClientRect(),dpr=Math.min(window.devicePixelRatio||1,2);
  const cw=Math.max(1,Math.round(rect.width*dpr)),ch=Math.max(1,Math.round(rect.height*dpr));
  if(c.width!==cw||c.height!==ch){c.width=cw;c.height=ch}
  const ctx=c.getContext('2d');ctx.clearRect(0,0,cw,ch);
  const fresh=a&&a.available===true&&Number.isFinite(+a.at_ms)&&(Date.now()-a.at_ms)<1800;
  if(!fresh)return;
  const sw=(img&&img.naturalWidth)||1280,sh=(img&&img.naturalHeight)||720;
  if(sw<=0||sh<=0)return;
  const scale=Math.min(cw/sw,ch/sh),ox=(cw-sw*scale)/2,oy=(ch-sh*scale)/2;
  const pt=p=>Array.isArray(p)&&Number.isFinite(+p[0])&&Number.isFinite(+p[1])?[ox+(+p[0])*scale,oy+(+p[1])*scale]:null;
  const circle=(p,r,color)=>{if(!p)return;ctx.strokeStyle=color;ctx.lineWidth=Math.max(2,2*dpr);ctx.beginPath();ctx.arc(p[0],p[1],r*dpr,0,Math.PI*2);ctx.stroke()};
  const line=(p1,p2,color,width=2)=>{if(!p1||!p2)return;ctx.strokeStyle=color;ctx.lineWidth=Math.max(1,width*dpr);ctx.beginPath();ctx.moveTo(p1[0],p1[1]);ctx.lineTo(p2[0],p2[1]);ctx.stroke()};
  const cross=(p,r,color)=>{if(!p)return;line([p[0]-r*dpr,p[1]],[p[0]+r*dpr,p[1]],color,2);line([p[0],p[1]-r*dpr],[p[0],p[1]+r*dpr],color,2)};
  const sb=a.setpoint_box,sc=pt(a.setpoint_center);
  if(Array.isArray(sb)&&sb.length===4&&sb.every(v=>Number.isFinite(+v))){
    const p1=pt([sb[0],sb[2]]),p2=pt([sb[1],sb[3]]);
    ctx.strokeStyle='#ff334d';ctx.lineWidth=Math.max(2,2*dpr);
    ctx.strokeRect(p1[0],p1[1],p2[0]-p1[0],p2[1]-p1[1]);
    cross(sc,9,'#ff334d');
  }
  const lh=pt(a.left_hole_center),rh=pt(a.right_hole_center);
  if(a.left_hole_valid&&a.right_hole_valid&&lh&&rh){
    line(lh,rh,'#ffd84d',2);circle(lh,7,'#ffd84d');circle(rh,7,'#ffd84d');
    const mid=pt(a.holes_midpoint);if(mid){ctx.fillStyle='#ffd84d';ctx.beginPath();ctx.moveTo(mid[0],mid[1]-6*dpr);ctx.lineTo(mid[0]+6*dpr,mid[1]);ctx.lineTo(mid[0],mid[1]+6*dpr);ctx.lineTo(mid[0]-6*dpr,mid[1]);ctx.closePath();ctx.strokeStyle='#ffd84d';ctx.lineWidth=2*dpr;ctx.stroke()}
  }
  const bc=pt(a.detected_block_center),bb=a.detected_block_box;
  if(a.block_detected&&bc){
    if(Array.isArray(bb)&&bb.length===4&&bb.every(v=>Number.isFinite(+v))){
      const p1=pt([bb[0],bb[1]]),p2=pt([bb[2],bb[3]]);
      ctx.strokeStyle='#35e69f';ctx.lineWidth=Math.max(2,2*dpr);ctx.strokeRect(p1[0],p1[1],p2[0]-p1[0],p2[1]-p1[1]);
    }
    circle(bc,6,'#35e69f');
    if(sc){
      line(bc,sc,'#ff30ef',2);
      const ang=Math.atan2(sc[1]-bc[1],sc[0]-bc[0]),r=10*dpr;
      const pA=[sc[0]-r*Math.cos(ang-.55),sc[1]-r*Math.sin(ang-.55)];
      const pB=[sc[0]-r*Math.cos(ang+.55),sc[1]-r*Math.sin(ang+.55)];
      line(sc,pA,'#ff30ef',2);line(sc,pB,'#ff30ef',2);
    }
  }
}
