function resolveMetricPath(path){if(!path)return undefined;if(path==='derived.cte_m')return derivedCte();if(path==='derived.endpoint_error_m')return derivedEndpoint();if(path==='derived.path_heading_error_rad')return derivedHeadingError();if(path==='derived.velocity_error_mps')return (+raw('esc_drive_actual')||0)-(+obj('cmd_final').linear_x||0);if(path==='derived.steering_error_rad')return (+raw('esc_steer_actual')||0)-(+raw('esc_steer_target')||0);if(Object.prototype.hasOwnProperty.call(state,path))return state[path];const parts=path.split('.');for(let n=parts.length-1;n>0;n--){const root=parts.slice(0,n).join('.');if(Object.prototype.hasOwnProperty.call(state,root)){let v=state[root];for(const p of parts.slice(n)){if(v==null)return undefined;v=v[p]}return v}}return undefined}
function currentPose(){const g=obj('ekf_global');if(Number.isFinite(+g.x))return g;const l=obj('ekf_local');return Number.isFinite(+l.x)?l:null}
function nearestPathInfo(){const pose=currentPose(),pts=obj('local_path').points||obj('nav_path').points||[];if(!pose||!pts.length)return null;let best=null;for(const p of pts){const d=Math.hypot((+p[0])-pose.x,(+p[1])-pose.y);if(!best||d<best.d)best={d,p}}return best}
function derivedCte(){return nearestPathInfo()?.d}
function derivedEndpoint(){const pose=currentPose(),goal=obj('goal_pose');if(!pose||!Number.isFinite(+goal.x))return undefined;return Math.hypot(pose.x-goal.x,pose.y-goal.y)}
function wrapPi(v){while(v>Math.PI)v-=2*Math.PI;while(v<-Math.PI)v+=2*Math.PI;return v}
function derivedHeadingError(){const pose=currentPose(),n=nearestPathInfo();if(!pose||!n||!Number.isFinite(+n.p[2]))return undefined;return wrapPi((pose.yaw||0)-(+n.p[2]))}
