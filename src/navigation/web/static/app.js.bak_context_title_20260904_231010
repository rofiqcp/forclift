function rememberTuningBaseline(fields){for(const p of fields||[]){if(!p.yamlFileKey||!p.yamlPath)continue;const k=baselineKey(p.yamlFileKey,p.yamlPath);if(tuningBaseline.has(k))continue;const v=configValue(p.yamlFileKey,p.yamlPath);if(v!==undefined)tuningBaseline.set(k,structuredClone(v))}}
