function experimentSortKey(id){const final=id.startsWith('F')?1:0;const nums=(id.match(/\d+/g)||[]).map(Number);return [final,...nums]}
function compareExperiment(a,b){const A=experimentSortKey(a.id),B=experimentSortKey(b.id);for(let i=0;i<Math.max(A.length,B.length);i++){const d=(A[i]??-1)-(B[i]??-1);if(d)return d}return a.id.localeCompare(b.id)}
