Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    # Keep the TF tree available for debugging, but do not draw link names/axes
    # over the map by default.  The visible robot should come from STL meshes.
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Update Interval: 0
      Value: false

    # RobotModel intentionally mirrors mapping.rviz: description comes from
    # /robot_description and link transforms are resolved through visual_/.
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: visual_
      Update Interval: 0.10
      Value: true
      Visual Enabled: true
    - Alpha: 0.80
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
    - Alpha: 0.25
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: GlobalCostmap + Inflation
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
    - Alpha: 0.25
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: LocalCostmap + Inflation
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Line Width: 0.08
      Name: SmacHybridAStarPath
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /smac_plan
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 0; 200; 255
      Enabled: true
      Line Width: 0.03
      Name: MPPITransformedGlobalPlan
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /transformed_global_plan
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MPPIAckermannTrajectories
      Namespaces:
        {}
      Queue Size: 10
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /trajectories
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LiveLaserScan
      Queue Size: 5
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan_nav
      Use Fixed Frame: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.15
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 0.2
          Value: false
        Position:
          Alpha: 0.15
          Color: 204; 51; 204
          Scale: 0.2
          Value: false
        Value: false
      Enabled: true
      Keep: 1
      Name: OdometryFiltered
      Position Tolerance: 0.1
      Shape:
        Alpha: 0.85
        Axes Length: 0.25
        Axes Radius: 0.02
        Color: 190; 90; 220
        Head Length: 0.12
        Head Radius: 0.05
        Shaft Length: 0.30
        Shaft Radius: 0.018
        Value: Arrow
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /odometry/filtered
    - Alpha: 1
      Class: rviz_default_plugins/Pose
      Color: 0; 255; 0
      Enabled: true
      Length: 0.5
      Name: GoalPose
      Shape: Arrow
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /goal_pose
    - Alpha: 0.5
      Class: rviz_default_plugins/Polygon
      Color: 0; 255; 0
      Enabled: true
      Name: RobotFootprint
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_costmap/published_footprint
    # Autonomous shows ONLY the YOLO-processed/annotated camera stream.
    # The raw Astra topic remains available to the detector but is intentionally
    # not displayed in RViz.
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: true
      Name: YOLO Processed Camera
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /obstacle_detection/visualization
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose_safe
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Orthographic Scale: 20
      Target Frame: <Fixed Frame>
Window Geometry:
  YOLO Processed Camera:
    X: 1280
    Y: 0
    Width: 640
    Height: 720
  Height: 720
  Width: 1920
