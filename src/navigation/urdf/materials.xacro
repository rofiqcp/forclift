<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agv_forklift_materials">

  <!-- Materials for visual rendering -->
  <material name="agv_gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>


  <material name="motor_orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>


  <material name="bearing_steel">
    <color rgba="0.4 0.4 0.45 1.0"/>
  </material>

</robot>
