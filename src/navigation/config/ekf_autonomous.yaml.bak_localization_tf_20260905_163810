ekf_filter_node:
  ros__parameters:
    # PART-1 production local odometry.
    # TF ownership is singular:
    #   AMCL -> map -> odom
    #   EKF  -> odom -> base_footprint
    # Wheel/ESC velocity + IMU gyro are the production local-motion sources.
    # LiDAR scan matching is diagnostic-only and does not enter this EKF.
    frequency: 30.0
    sensor_timeout: 0.35
    two_d_mode: true
    publish_tf: true
    publish_acceleration: false
    print_diagnostics: true

    map_frame: map
    odom_frame: odom
    base_link_frame: base_footprint
    world_frame: odom

    # Primary longitudinal motion source. Offline ESC placeholders carry very
    # large covariance in esc_driver_node and therefore cannot pin the EKF.
    odom0: /esc/odom
    odom0_config: [false, false, false,
                   false, false, false,
                   true,  true,  false,
                   false, false, false,
                   false, false, false]
    odom0_differential: false
    odom0_relative: false
    odom0_queue_size: 50
    odom0_nodelay: true
    odom0_twist_rejection_threshold: 2.0

    # PART-5 Stage-1: /lidar/odom remains available as a diagnostic and
    # offline/fallback comparison topic, but is intentionally NOT fused here.
    # This avoids correlating the same LiDAR measurement through both the
    # local EKF and AMCL/SLAM global localization path.

    # Fast heading-rate source. Absolute magnetometer yaw is intentionally not
    # fused indoors until it has been calibrated and validated.
    imu0: /imu/data
    imu0_config: [false, false, false,
                  false, false, false,
                  false, false, false,
                  false, false, true,
                  false, false, false]
    imu0_differential: false
    imu0_relative: false
    imu0_remove_gravitational_acceleration: false
    imu0_queue_size: 100
    imu0_nodelay: true
    imu0_twist_rejection_threshold: 1.5
