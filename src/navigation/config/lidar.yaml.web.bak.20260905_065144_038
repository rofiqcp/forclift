/**:
  ros__parameters:
    # Use the stable LiDAR symlink created by resolve_usb_roles.py.
    # This is the verified by-path alias for physical hub port 1-2.1.4 (ttyUSB1).
    port: /tmp/agv_devices/lidar
    baudrate: 230400
    frame_id: "lidar_link"

    # Reference master mapping values: one physical revolution -> one /scan.
    scan_frequency: 10.0
    scan_publish_rate: 10.0
    scan_timeout: 0.6
    # If serial stays open but completed revolutions stop, force a clean reopen.
    stream_recovery_timeout: 2.5
    stream_recovery_cooldown: 1.0
    recovery_grace_sec: 4.0
    hard_restart_delay_sec: 6.0
    soft_recovery_attempts_before_hard: 2
    target_scan_period: 0.1
    range_min: 0.12
    # Mapping only trusts geometry inside 8 m; clip farther returns here so
    # long-range spikes never reach RViz/SLAM.
    range_max: 6.0
    angle_offset: 0.0
    angle_min: 0.0
    angle_max: 359.0
    invert_angle: true

    # This AGV uses the 25 m T-mini Plus SH profile. YDLIDAR identifies the
    # SH model as 16-bit intensity, so each point is 4 bytes:
    #   intensity uint16 + distance uint16.
    # 2-byte mode previously accepted mostly zero/ring packets; 3-byte mode
    # produced valid_packets=0. Keep the exact SH wire layout here.
    intensity_mode: true
    intensity_bits: 16
    strict_checksum: true

    # V38 navigation-only denoising.  The independent /scan_safety stream is
    # published before this filter and therefore remains conservative.
    # Navigation returns need denser angular support and tighter two-frame
    # agreement so isolated rays cannot mark either costmap or the saved map.
    spatial_filter_enabled: true
    spatial_filter_radius_bins: 6
    spatial_filter_min_support: 3
    spatial_filter_abs_tolerance_m: 0.12
    spatial_filter_rel_tolerance: 0.02
    temporal_filter_enabled: true
    temporal_filter_radius_bins: 1
    temporal_filter_range_diff_m: 0.14
    # Cartesian endpoint continuity preserves oblique walls better than a pure
    # range-difference test, while isolated radial spikes fail this gate.
    spatial_endpoint_max_gap_m: 0.22
    # Short far runs between the same near surface are removed even if the
    # hardware artifact repeats in successive revolutions.
    far_shadow_max_run_bins: 8
    min_valid_bins_per_scan: 40

    auto_detect_port: false
    # The resolver guarantees IMU and LiDAR resolve to different physical
    # hub ports. Exclude the stable IMU alias so detection never probes it.
    exclude_ports: "/tmp/agv_devices/imu"
