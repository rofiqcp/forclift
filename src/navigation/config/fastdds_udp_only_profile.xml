<?xml version="1.0" encoding="UTF-8"?>
<!-- FastDDS profile: UDP-only transport. Disables shared-memory (SHM) transport
     to avoid /dev/shm/fastrtps_port* lock collisions when a previous ROS run is
     force-killed and orphans its DDS participants. Created for autonomous.launch.py. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="autonomous_udp_only" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
