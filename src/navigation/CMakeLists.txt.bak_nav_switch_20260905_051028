if(BUILD_TESTING)
  # ament_cmake_pytest emits a CMake WARNING when the Python pytest module is
  # absent. Detect the module first so a normal production build stays clean.
  find_package(Python3 COMPONENTS Interpreter QUIET)
  set(NAVIGATION_PYTEST_AVAILABLE FALSE)
  if(Python3_Interpreter_FOUND)
    execute_process(
      COMMAND "${Python3_EXECUTABLE}" -c "import pytest"
      RESULT_VARIABLE NAVIGATION_PYTEST_IMPORT_RC
      OUTPUT_QUIET ERROR_QUIET)
    if(NAVIGATION_PYTEST_IMPORT_RC EQUAL 0)
      set(NAVIGATION_PYTEST_AVAILABLE TRUE)
    endif()
  endif()

  if(NAVIGATION_PYTEST_AVAILABLE)
    find_package(ament_cmake_pytest REQUIRED)
    ament_add_pytest_test(test_calibration_math test/test_calibration_math.py
      APPEND_ENV PYTHONPATH=${CMAKE_CURRENT_SOURCE_DIR}/python TIMEOUT 60)
    ament_add_pytest_test(test_path_metrics test/test_path_metrics.py
      APPEND_ENV PYTHONPATH=${CMAKE_CURRENT_SOURCE_DIR}/python TIMEOUT 60)
    ament_add_pytest_test(test_runtime_schema test/test_runtime_schema.py
      APPEND_ENV PYTHONPATH=${CMAKE_CURRENT_SOURCE_DIR}/python TIMEOUT 60)
  else()
    message(STATUS "navigation: pytest not installed; optional Python unit tests are skipped")
  endif()
endif()

ament_package()
